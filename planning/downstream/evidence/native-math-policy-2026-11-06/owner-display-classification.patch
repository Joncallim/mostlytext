diff --git a/Sources/Textual/Attachment/AttachmentAccessibility.swift b/Sources/Textual/Attachment/AttachmentAccessibility.swift
index b85191f..513112c 100644
--- a/Sources/Textual/Attachment/AttachmentAccessibility.swift
+++ b/Sources/Textual/Attachment/AttachmentAccessibility.swift
@@ -18,7 +18,19 @@ public struct AttachmentAccessibility: Sendable, Hashable {
 extension AnyAttachment {
   /// Supplies semantics without replacing the attachment's drawing or measurement.
   public func withAccessibility(_ descriptor: AttachmentAccessibility) -> Self {
-    .init(AccessibleAttachment(base: self, descriptor: descriptor))
+    // Replacing a descriptor retains a single semantic wrapper.
+    let underlying = (base as? AccessibleAttachment)?.base ?? self
+    return .init(AccessibleAttachment(base: underlying, descriptor: descriptor))
+  }
+
+  var isDisplayMath: Bool {
+    if let wrapper = base as? AccessibleAttachment {
+      return wrapper.base.isDisplayMath
+    }
+    guard let math = base as? MathAttachment, case .block = math.displayStyle else {
+      return false
+    }
+    return true
   }
 }
 
diff --git a/Sources/Textual/Internal/Helpers/AttributedString.swift b/Sources/Textual/Internal/Helpers/AttributedString.swift
index 911bbc0..ff4a6cf 100644
--- a/Sources/Textual/Internal/Helpers/AttributedString.swift
+++ b/Sources/Textual/Internal/Helpers/AttributedString.swift
@@ -6,8 +6,7 @@ extension AttributedStringProtocol {
 
     guard
       attachments.count == 1,
-      let attachment = attachments.first?.base as? MathAttachment,
-      case .block = attachment.displayStyle
+      attachments.first?.isDisplayMath == true
     else {
       return false
     }

+/* Existing inline algorithms use relative columns internally. Correct metadata
+ * only after parsing/emphasis completes, so provenance cannot change semantics. */
+static void correct_inline_source_positions(cmark_node *parent) {
+  if (!parent->source_segment_count) return;
+  size_t count = 1, capacity = 8;
+  bufsize_t *starts = parent->content.mem->calloc(capacity, sizeof(bufsize_t));
+  for (bufsize_t offset = 0; offset < parent->content.size; offset++) {
+    unsigned char ch = parent->content.ptr[offset];
+    if (ch != '\r' && ch != '\n') continue;
+    if (ch == '\r' && offset + 1 < parent->content.size && parent->content.ptr[offset + 1] == '\n') offset++;
+    if (count == capacity) {
+      capacity *= 2;
+      starts = parent->content.mem->realloc(starts, capacity * sizeof(bufsize_t));
+    }
+    starts[count++] = offset + 1;
+  }
+  int base = parent->start_column - 1 + parent->internal_offset;
+  cmark_iter *iterator = cmark_iter_new(parent);
+  cmark_event_type event;
+  while ((event = cmark_iter_next(iterator)) != CMARK_EVENT_DONE) {
+    cmark_node *node = cmark_iter_get_node(iterator);
+    if (event != CMARK_EVENT_ENTER || node == parent || !node->start_line || !node->start_column) continue;
+    int first = node->start_line - parent->start_line;
+    int last = node->end_line - parent->start_line;
+    int end_base = base;
+    if (last > first && (node->type == CMARK_NODE_CODE || node->type == CMARK_NODE_HTML_INLINE)) end_base = 0;
+    if (first < 0 || last < 0 || (size_t)first >= count || (size_t)last >= count) {
+      node->start_line = node->start_column = node->end_line = node->end_column = 0;
+      continue;
+    }
+    bufsize_t begin = starts[first] + node->start_column - 1 - base;
+    bufsize_t end = starts[last] + node->end_column - 1 - end_base;
+    if (last > first && node->type == CMARK_NODE_HTML_INLINE) end++;
+    int sl, sc, el, ec;
+    if (begin >= 0 && end >= begin && end < parent->content.size &&
+        cmark_node_source_position(parent, begin, &sl, &sc) &&
+        cmark_node_source_position(parent, end, &el, &ec)) {
+      node->start_line = sl; node->start_column = sc;
+      node->end_line = el; node->end_column = ec;
+    } else {
+      node->start_line = node->start_column = node->end_line = node->end_column = 0;
+    }
+  }
+  cmark_iter_free(iterator);
+  parent->content.mem->free(starts);
+}

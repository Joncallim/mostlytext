+  if (count && node->source_segments[count - 1].content_offset == content_offset) {
+    node->source_segments[count - 1].line = line;
+    node->source_segments[count - 1].column = column;
+    return;
+  }
+  if (count == node->source_segment_capacity) {
+    size_t capacity = count ? count * 2 : 4;
+    node->source_segments = NODE_MEM(node)->realloc(
+        node->source_segments, capacity * sizeof(cmark_source_segment));
+    node->source_segment_capacity = capacity;
+  }
+  node->source_segments[count].content_offset = content_offset;
+  node->source_segments[count].line = line;
+  node->source_segments[count].column = column;
+  node->source_segment_count++;
+}
+
+bool cmark_node_source_position(const cmark_node *node, bufsize_t content_offset,
+                                int *line, int *column) {
+  size_t low = 0, high = node->source_segment_count;
+  bufsize_t offset = content_offset + node->source_content_offset;
+  while (low < high) {
+    size_t middle = low + (high - low) / 2;
+    if (node->source_segments[middle].content_offset <= offset)
+      low = middle + 1;
+    else
+      high = middle;
+  }
+  if (!low) return false;
+  const cmark_source_segment *segment = &node->source_segments[low - 1];
+  *line = segment->line;
+  *column = segment->column + offset - segment->content_offset;
+  return true;
+}
+
+/* Table extraction has already unescaped pipes and trimmed the target text.
+ * Copy the same byte transformation's provenance, validating every byte. */
+bool cmark_node_copy_source(cmark_node *target, const cmark_node *source,
+                            const unsigned char *input, bufsize_t offset,
+                            bufsize_t length) {
+  bufsize_t cursor = offset, end = offset + length, output = 0;
+  int line = 0, column = 0, first_line = 0, first_column = 0;
+  while (cursor < end && cmark_isspace(input[cursor])) cursor++;
+  while (cursor < end && output < target->content.size) {
+    if (input[cursor] == '\\' && cursor + 1 < end && input[cursor + 1] == '|') cursor++;
+    if (input[cursor] != target->content.ptr[output] ||
+        !cmark_node_source_position(source, cursor, &line, &column)) goto unavailable;
+    if (!output) { first_line = line; first_column = column; }
+    size_t count = target->source_segment_count;
+    if (!count || target->source_segments[count - 1].line != line ||
+        target->source_segments[count - 1].column + output -
+            target->source_segments[count - 1].content_offset != column)
+      cmark_node_record_source(target, output, line, column);
+    cursor++; output++;
+  }
+  if (output != target->content.size) goto unavailable;
+  if (output) {
+    target->start_line = first_line; target->start_column = first_column;
+    target->end_line = line; target->end_column = column;
+  }
+  return true;
+unavailable:
+  target->start_line = target->start_column = target->end_line = target->end_column = 0;
+  target->source_segment_count = 0;
+  return false;
+}

# ---- macOS ----
.DS_Store
.Trashes
*.swp
*~.nib

# ---- Xcode ----
DerivedData/
build/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside
*.xcuserstate
xcuserdata/

# ---- Swift Package Manager ----
.swiftpm/
Package.resolved
# Exception: MacDownKit's lock file is committed so CI builds the same
# dependency revisions every time. SwiftTreeSitter can only be declared as
# `branch: "main"` (Neon requires that), so this file is what stops it moving
# (#148 LC-05). CI enforces it with --force-resolved-versions and the Xcode pin
# step; local builds need the same flags (see AGENTS.md).
!MacDown2/Packages/MacDownKit/Package.resolved
# Scoped to MacDown2 on purpose: a bare `/.build/` would ignore any `.build/`
# anywhere in the repo and could suppress unexpected assets.
MacDown2/**/.build/

# ---- MacDown 2 (generated by XcodeGen; do not commit) ----
MacDown2/*.xcodeproj/
MacDown2/MacDown2/Info.plist
MacDown2/MacDown2QuickLook/Info.plist
MacDown2/MacDown2QuickLookWorker/Info.plist

# ---- Legacy reference (pre-cleanup MacDown backup) ----
# Now TRACKED (un-ignored) so the original MacDown resources — editor theme
# `.style`/CSS files under Resources/ and the `MPColor`/`MPUtilities` color tests —
# synchronise into the repo and serve as the porting source for EPIC-05 (themes +
# highlighting). See planning/epic-05-implementation.md §3.D4 and §4.11.
# If the backup is large, prefer committing only the theme/color subset it needs.

# Generated Python bytecode for repository tooling.
__pycache__/

        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dokument %@ nie odpowiada bieżącemu źródłu; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@'s range does not fall inside exactly one preview block; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la plage de %@ ne se situe pas exactement dans un seul bloc d'aperçu ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の範囲がちょうど1つのプレビューブロック内に収まっていません。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zakres %@ nie mieści się dokładnie w jednym bloku podglądu; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },

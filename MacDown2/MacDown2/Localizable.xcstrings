    },
    "%@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %@; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ has an invalid source range; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a une plage source non valide ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のソース範囲が無効です。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma nieprawidłowy zakres źródłowy; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ is stale; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est plus à jour ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は古くなっています。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest nieaktualne; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ is unavailable for this export; authored source preserved": {
      "extractionState": "manual"
    },
    "%@ overlaps another placement; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chevauche un autre placement ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が他の配置と重なっています。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nakłada się na inne umieszczenie; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ produced HTML, which Preview does not support; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a produit du HTML, que l'aperçu ne prend pas en charge ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がHTMLを生成しましたが、プレビューはHTMLに対応していません。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wygenerowało HTML, którego podgląd nie obsługuje; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ produced empty content; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a produit un contenu vide ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が空のコンテンツを生成しました。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wygenerowało pustą zawartość; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@'s document does not match the current source; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le document de %@ ne correspond pas à la source actuelle ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の書類が現在のソースと一致しません。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "dokument %@ nie odpowiada bieżącemu źródłu; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@'s range does not fall inside exactly one preview block; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la plage de %@ ne se situe pas exactement dans un seul bloc d'aperçu ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の範囲がちょうど1つのプレビューブロック内に収まっていません。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zakres %@ nie mieści się dokładnie w jednym bloku podglądu; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "A competing version was preserved as %@. Reveal it, then use Save As to keep this copy.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version concurrente a été conservée sous le nom %@. Révélez-la, puis utilisez Enregistrer sous pour conserver cette copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合するバージョンが%@として保存されました。それを表示してから、「別名で保存」でこのコピーを保持してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konkurencyjna wersja została zachowana jako %@. Odsłoń ją, a następnie użyj polecenia Zapisz jako, aby zachować tę kopię."
          }
        }
      }
    },
    "A competing version was preserved in the Themes folder as %@. Review it before continuing.": {
      "comment": "Theme management. Translation draft; native-speaker review remains required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une version concurrente a été conservée dans le dossier des thèmes sous le nom %@. Examinez-la avant de continuer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Konkurencyjna wersja została zachowana w folderze motywów jako %@. Sprawdź ją przed kontynuowaniem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "競合するバージョンがテーマフォルダに%@として保持されています。続行する前に確認してください。"
          }
        }
      }
    },
    "A different version of this theme is already installed. Replace it or import a separate copy.": {
      "comment": "Theme management. Translation draft; native-speaker review remains required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une autre version de ce thème est déjà installée. Remplacez-la ou importez une copie distincte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inna wersja tego motywu jest już zainstalowana. Zastąp ją lub zaimportuj osobną kopię."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このテーマの別のバージョンがすでにインストールされています。置き換えるか、別のコピーとして読み込んでください。"
          }
        }
      }
    },
    "A fast, native Markdown editor for Mac, with live preview, math, and diagrams built right in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un éditeur Markdown natif et rapide pour Mac, avec aperçu en direct, formules mathématiques et diagrammes intégrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブプレビュー、数式、図表を標準搭載した、高速でネイティブなMac用Markdownエディタです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybki, natywny edytor Markdown dla komputerów Mac z podglądem na żywo oraz wbudowaną obsługą wzorów matematycznych i diagramów."
          }
        }
      }
    },
    "A place for your words": {
      "comment": "Appearance settings. Translation draft; native-speaker review remains required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un espace pour vos mots"

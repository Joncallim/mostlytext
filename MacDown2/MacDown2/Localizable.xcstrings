    "Recovery cleanup for %@ needs attention. Reveal it, retry, or use Save As.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nettoyage de la récupération pour %@ nécessite votre attention. Révélez-le, réessayez, ou utilisez Enregistrer sous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の復旧クリーンアップに対応が必要です。表示するか、再試行するか、「別名で保存」を使ってください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czyszczenie odzyskiwania dla %@ wymaga uwagi. Odsłoń je, spróbuj ponownie albo użyj polecenia Zapisz jako."
          }
        }
      }
    },
    "Recovery for %@ could not be cleaned up. Keep this window open, or use Save As.": {
      "localizations": {
        "fr": {
          "stringUnit": {

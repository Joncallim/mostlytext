    "Applies the next time a new, untitled document is saved. Open documents keep their own encoding.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique la prochaine fois qu'un nouveau document sans titre est enregistré. Les documents ouverts conservent leur propre encodage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に新規の無題書類を保存するときに適用されます。開いている書類は各自のエンコーディングを維持します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma zastosowanie przy następnym zapisie nowego, nienazwanego dokumentu. Otwarte dokumenty zachowują własne kodowanie."
          }
        }
      }
    },

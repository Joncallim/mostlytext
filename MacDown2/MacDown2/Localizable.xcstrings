                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg prawidłowych umieszczeń przekroczyło budżet podglądu; zachowano źródło w oryginalnej postaci"
                    }
                  },
                  "one": {

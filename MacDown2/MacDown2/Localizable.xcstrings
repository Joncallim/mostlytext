    "%lld characters, %lld words": {
      "comment": "Status-bar character and word counts use independent plural substitutions. Non-English values are draft translations requiring native review.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@, %#@arg2@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg character"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg characters"

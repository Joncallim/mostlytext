          "stringUnit": {
            "state": "translated",
            "value": "%@ %@; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ has an invalid source range; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a une plage source non valide ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のソース範囲が無効です。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ma nieprawidłowy zakres źródłowy; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ is stale; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est plus à jour ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は古くなっています。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest nieaktualne; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ is unavailable for this export; authored source preserved": {
      "extractionState": "manual"
    },
    "%@ overlaps another placement; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chevauche un autre placement ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が他の配置と重なっています。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nakłada się na inne umieszczenie; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ produced HTML, which Preview does not support; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a produit du HTML, que l'aperçu ne prend pas en charge ; la source rédigée est conservée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がHTMLを生成しましたが、プレビューはHTMLに対応していません。作成時のソースを保持します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wygenerowało HTML, którego podgląd nie obsługuje; zachowano źródło w oryginalnej postaci"
          }
        }
      }
    },
    "%@ produced empty content; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a produit un contenu vide ; la source rédigée est conservée"

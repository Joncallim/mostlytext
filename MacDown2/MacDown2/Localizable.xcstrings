    "has a partial block placement outside a top-level paragraph": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "a un placement de bloc partiel en dehors d'un paragraphe de premier niveau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トップレベルの段落の外側で部分的なブロック配置になっています"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ma częściowe umieszczenie blokowe poza akapitem najwyższego poziomu"
          }
        }
      }
    },
    "has a partial block placement that does not align with whole physical lines": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "a un placement de bloc partiel qui ne s'aligne pas sur des lignes physiques entières"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な物理行に揃っていない部分的なブロック配置になっています"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ma częściowe umieszczenie blokowe, które nie jest zgodne z pełnymi fizycznymi wierszami"
          }
        }
      }
    },
    "has an inline placement that is not confined to one physical line": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "a un placement en ligne qui ne se limite pas à une seule ligne physique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの物理行に収まらないインライン配置になっています"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ma umieszczenie w linii, które nie ogranicza się do jednego fizycznego wiersza"
          }
        }
      }
    },
    "internal composition invariant violated; contributions left as authored source": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "un invariant interne de composition a été violé ; les contributions restent telles que rédigées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部の合成不変条件に違反しました。コンテンツは作成時のソースのまま残します"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "naruszono wewnętrzny niezmiennik składania; wkłady pozostają w oryginalnej postaci źródła"
          }
        }
      }
    },
    "parsed revision %lld could not be represented; contributions skipped": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la révision analysée %lld n'a pas pu être représentée ; les contributions ont été ignorées"

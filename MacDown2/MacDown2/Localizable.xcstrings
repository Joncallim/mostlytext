        }
      }
    },
    "%@'s document does not match the current source; authored source preserved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le document de %@ ne correspond pas à la source actuelle ; la source rédigée est conservée"

        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "przeanalizowana wersja %lld nie mogła zostać przedstawiona; wkłady pominięto"
          }
        }
      }
    },
    "preview blocks are not ordered/non-overlapping; contributions left as authored source": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les blocs d'aperçu ne sont pas ordonnés/non chevauchants ; les contributions restent telles que rédigées"

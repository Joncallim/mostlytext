    "    Split Editor & Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "    Éditeur et aperçu partagés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "    エディタとプレビューを分割"

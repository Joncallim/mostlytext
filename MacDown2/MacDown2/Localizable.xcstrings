    "This theme has low-contrast text. You can keep using it or choose another theme.": {
      "comment": "Theme management. Translation draft; native-speaker review remains required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le texte de ce thème présente un faible contraste. Vous pouvez continuer à l’utiliser ou choisir un autre thème."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekst w tym motywie ma niski kontrast. Możesz nadal go używać lub wybrać inny motyw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "このテーマの文字はコントラストが低くなっています。そのまま使うか、別のテーマを選択できます。"

        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "言葉をつづる場所"
          }
        }
      }
    },
    "A quotation keeps its own voice.": {
      "comment": "Appearance settings. Translation draft; native-speaker review remains required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une citation garde sa propre voix."

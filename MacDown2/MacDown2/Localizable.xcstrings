    "A competing version was preserved as %@. Reveal it, then use Save As to keep this copy.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version concurrente a été conservée sous le nom %@. Révélez-la, puis utilisez Enregistrer sous pour conserver cette copie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

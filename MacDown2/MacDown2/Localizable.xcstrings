    "^[%lld valid placement](inflect: true) exceeded the preview budget and remain as authored source": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg emplacement valide a dépassé le budget d'aperçu ; la source rédigée est conservée"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg emplacements valides ont dépassé le budget d'aperçu ; la source rédigée est conservée"
                    }
                  }
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg件の有効な配置がプレビューの上限を超えました。作成時のソースを保持します"
                    }
                  }
                }
              }
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@"
          },

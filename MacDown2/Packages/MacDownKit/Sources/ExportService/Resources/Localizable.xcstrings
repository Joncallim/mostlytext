          }
        }
      }
    },
    "Split the document, or reduce the size of the images it references.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisez le document, ou réduisez la taille des images qu'il référence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書類を分割するか、参照している画像のサイズを小さくしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel dokument albo zmniejsz rozmiar obrazów, do których się on odwołuje."
          }
        }
      }
    },
    "The export destination changed after it was selected. Choose it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export destination changed after it was selected. Choose it again."

    "An export staging file needs recovery at: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An export staging file needs recovery at: %@"
          }
        }
      }
    },
    "Authored raw HTML is rendered best-effort by the print system; it cannot load scripts or remote resources.": {
      "comment": "Export warning/detail routed through the package bundle. Non-English values are explicit English review drafts, not accepted translations.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authored raw HTML is rendered best-effort by the print system; it cannot load scripts or remote resources."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authored raw HTML is rendered best-effort by the print system; it cannot load scripts or remote resources."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Authored raw HTML is rendered best-effort by the print system; it cannot load scripts or remote resources."
          }
        }
      }
    },
    "Check that the destination folder exists and is writable.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le dossier de destination existe et qu'il est accessible en écriture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し先のフォルダが存在し、書き込み可能であることを確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy folder docelowy istnieje i czy można w nim zapisywać."
          }
        }
      }
    },
    "Choose a different destination folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un autre dossier de destination."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の書き出し先フォルダを選んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inny folder docelowy."
          }
        }
      }
    },
    "Choose an export destination that is not a source or open document.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an export destination that is not a source or open document."
          }
        }
      }
    },
    "Choose another export name or destination. Existing files have been preserved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another export name or destination. Existing files have been preserved."
          }
        }
      }
    },
    "Choose the HTML format, which preserves authored raw HTML.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le format HTML, qui préserve le HTML brut tel qu'il a été rédigé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成時の生のHTMLをそのまま保持するHTML形式を選んでください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz format HTML, który zachowuje surowy kod HTML w oryginalnej postaci."
          }
        }
      }
    },
    "Export destination is invalid: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination d'export n'est pas valide : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し先が無効です: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce docelowe eksportu jest nieprawidłowe: %@"
          }
        }
      }
    },
    "Export recovery storage is unavailable or in use: %@": {
      "comment": "Export failure. The placeholder is the private recovery folder path; do not suggest deleting it.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export recovery storage is unavailable or in use: %@"
          }
        }
      }
    },
    "Finish other exports and try again. If this continues, preserve the recovery folder and contact support.": {
      "comment": "Recovery suggestion after private export storage could not be admitted. Preserve recovery evidence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish other exports and try again. If this continues, preserve the recovery folder and contact support."
          }
        }
      }
    },
    "Fix the image paths, or export as HTML, which keeps unresolved references as authored.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez les chemins des images, ou exportez au format HTML, qui conserve les références non résolues telles qu'elles ont été rédigées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像のパスを修正するか、未解決の参照をそのまま保持するHTML形式で書き出してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw ścieżki obrazów albo wyeksportuj jako HTML, który zachowuje nierozwiązane odwołania w formie, w jakiej zostały napisane."
          }
        }
      }
    },
    "HTML rendering failed: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du rendu HTML : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTMLのレンダリングに失敗しました: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderowanie HTML nie powiodło się: %@"
          }
        }
      }
    },

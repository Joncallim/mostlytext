    "Preserve that file and choose another export destination.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserve that file and choose another export destination."
          }
        }
      }
    },
    "Removed the target of \"%@\": that URL scheme is not allowed in an exported document.": {
      "comment": "Export warning/detail routed through the package bundle. Non-English values are explicit English review drafts, not accepted translations.",
      "localizations": {
        "fr": {

            "value": "%@ is not an image file"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ is not an image file"
          }
        }
      }
    },
    "%lld math or diagram fragment(s) sit inside a link, reference definition or HTML construct and cannot be placed there; they are exported as their source text": {
      "comment": "Export warning/detail routed through the package bundle. Non-English values are explicit English review drafts, not accepted translations.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld math or diagram fragment(s) sit inside a link, reference definition or HTML construct and cannot be placed there; they are exported as their source text"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%lld math or diagram fragment(s) sit inside a link, reference definition or HTML construct and cannot be placed there; they are exported as their source text"

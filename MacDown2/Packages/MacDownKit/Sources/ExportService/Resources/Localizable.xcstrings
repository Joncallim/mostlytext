    "This document contains raw HTML, which cannot be embedded in a self-contained file. Export it as HTML instead.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document contient du HTML brut, qui ne peut pas être intégré dans un fichier autonome. Exportez-le plutôt au format HTML."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この書類には生のHTMLが含まれているため、自己完結ファイルには埋め込めません。代わりにHTMLとして書き出してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten dokument zawiera surowy kod HTML, którego nie można osadzić w samodzielnym pliku. Wyeksportuj go zamiast tego jako HTML."
          }
        }
      }
    },

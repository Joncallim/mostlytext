          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "rendered output too large (%lld bytes)"
          }
        }
      }
    },
    "renderer unavailable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "moteur de rendu indisponible"
          }
        },
        "ja": {

{
  "sourceLanguage": "en",
  "strings": {
    "diagram could not be rendered: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "le diagramme n'a pas pu être généré : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図を描画できませんでした: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "nie można było wyrenderować diagramu: %@"
          }
        }
      }
    },
    "rendered output too large (%@ bytes)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "résultat généré trop volumineux (%@ octets)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画結果が大きすぎます(%@バイト)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "wyrenderowany wynik jest zbyt duży (%@ bajtów)"
          }
        }
      }
    },
    "rendered output too large (%lld bytes)": {
      "comment": "Exact key from the current first-party Apple compiler extraction. Non-English values are explicit English review drafts; native language/plural review remains required.",
      "localizations": {
        "en": {
          "stringUnit": {

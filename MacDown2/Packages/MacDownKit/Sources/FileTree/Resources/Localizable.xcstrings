{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" already exists.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » existe déjà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでに存在します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” już istnieje."
          }
        }
      }
    },
    "\"%@\" is not a valid name.": {
      "comment": "Exact key from the current first-party Apple compiler extraction. Non-English values are explicit English review drafts; native language/plural review remains required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" is not a valid name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" is not a valid name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" is not a valid name."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" is not a valid name."
          }
        }
      }
    },
    "A folder cannot be moved into itself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier ne peut pas être déplacé dans lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを自分自身の中に移動することはできません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przenieść folderu do niego samego."
          }
        }
      }
    },
    "A name is required.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom est requis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を入力してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa jest wymagana."
          }
        }
      }
    },
    "Folder operation failed (POSIX error %@).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'opération sur le dossier (erreur POSIX %@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダの操作に失敗しました(POSIXエラー%@)。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja na folderze nie powiodła się (błąd POSIX %@)."
          }
        }
      }
    },
    "Folder operation failed (POSIX error %d).": {
      "comment": "Exact key from the current first-party Apple compiler extraction. Non-English values are explicit English review drafts; native language/plural review remains required.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder operation failed (POSIX error %d)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folder operation failed (POSIX error %d)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folder operation failed (POSIX error %d)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Folder operation failed (POSIX error %d)."
          }
        }
      }
    },
    "Names cannot contain / or :.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms ne peuvent pas contenir / ni :."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前に「/」や「:」を含めることはできません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy nie mogą zawierać znaków / ani :."
          }
        }
      }
    },
    "The destination is not a folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination n'est pas un dossier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先はフォルダではありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce docelowe nie jest folderem."
          }
        }
      }
    },
    "The destination is outside the open folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination se trouve en dehors du dossier ouvert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動先が開いているフォルダの外にあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Miejsce docelowe znajduje się poza otwartym folderem."
          }
        }
      }
    },
    "The folder changed before the operation could start.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier a changé avant que l'opération ait pu commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作が始まる前にフォルダが変更されました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder zmienił się, zanim operacja mogła się rozpocząć."
          }
        }
      }
    },
    "The folder is no longer available.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier n'est plus disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダはもう利用できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder nie jest już dostępny."
          }
        }
      }
    },
    "The item no longer exists.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'élément n'existe plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はもう存在しません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element już nie istnieje."
          }
        }
      }
    }
  },
  "version": "1.0"
}

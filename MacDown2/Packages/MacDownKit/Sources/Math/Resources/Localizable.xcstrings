    "Math analysis could not be safely completed. Export was stopped.": {
      "comment": "Shared Preview/Export math diagnosis or accessible source action. Source text and location are opaque substitutions. Translation and native review required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’analyse des équations n’a pas pu être effectuée en toute sécurité. L’exportation a été arrêtée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "数式の解析を安全に完了できませんでした。書き出しを停止しました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie udało się bezpiecznie ukończyć analizy równań. Eksport został zatrzymany."
          }
        }
      }
    },
    "Show equation source": {
      "comment": "Shared Preview/Export math diagnosis or accessible source action. Source text and location are opaque substitutions. Translation and native review required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Afficher le code source de l’équation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "数式のソースを表示"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokaż źródło równania"
          }
        }
      }
    },
    "The equation contains a character this renderer does not support. Its source is shown.": {
      "comment": "Shared Preview/Export math diagnosis or accessible source action. Source text and location are opaque substitutions. Translation and native review required.",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’équation contient un caractère non pris en charge par ce moteur de rendu. Son code source est affiché."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "数式にこのレンダラーが対応していない文字が含まれています。ソースを表示しています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Równanie zawiera znak nieobsługiwany przez ten moduł renderowania. Wyświetlono jego źródło."
          }
        }
      }
    },
    "The equation contains an unrecognized command. Its source is shown.": {

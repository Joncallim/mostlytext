{
  "sourceLanguage": "en",
  "strings": {
    "Couldn't run the command: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'exécuter la commande : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドを実行できませんでした: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uruchomić polecenia: %@"
          }
        }
      }
    },
    "The command could not be confirmed stopped.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arrêt de la commande n'a pas pu être confirmé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドが停止したことを確認できませんでした。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić zatrzymania polecenia."
          }
        }
      }
    },
    "The command exited with status %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande s'est terminée avec le statut %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはステータス%@で終了しました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie zakończyło się kodem %@."
          }
        }
      }
    },
    "The command exited with status %@: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande s'est terminée avec le statut %@ : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはステータス%@で終了しました: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie zakończyło się kodem %@: %@"
          }
        }
      }
    },
    "The command produced more output than MostlyText will accept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La commande a produit plus de données que MostlyText n'en accepte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "コマンドの出力がMostlyTextの許容量を超えました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Polecenie wygenerowało więcej danych wyjściowych, niż akceptuje MostlyText."
          }
        }
      }
    },
    "The command took too long and was stopped.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande a pris trop de temps et a été arrêtée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの実行に時間がかかりすぎたため停止しました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie trwało zbyt długo i zostało zatrzymane."
          }
        }
      }
    },
    "The command was cancelled.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドはキャンセルされました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie zostało anulowane."
          }
        }
      }
    },
    "The command's output could not be fully read.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie de la commande n'a pas pu être lue entièrement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの出力を完全に読み取れませんでした。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się w pełni odczytać danych wyjściowych polecenia."
          }
        }
      }
    },
    "The command's output wasn't valid text.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie de la commande n'était pas du texte valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの出力は有効なテキストではありませんでした。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane wyjściowe polecenia nie były prawidłowym tekstem."
          }
        }
      }
    }
  },
  "version": "1.0"
}
